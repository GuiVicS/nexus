#!/bin/sh
# curl falso: responde só à consulta da release mais nova (url_effective). $NEXUS_FAKE_SYS/latest muda a versão e
# $NEXUS_FAKE_SYS/offline simula a falta de internet.
S=${NEXUS_FAKE_SYS:-/tmp/nexus-fake-sys}
[ -f "$S/offline" ] && exit 6
echo "https://github.com/GuiVicS/nexus/releases/tag/v$(cat "$S/latest" 2>/dev/null || echo 0.5.0)"
