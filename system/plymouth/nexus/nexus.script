# Tela de boot do Nexus: fundo escuro, marca no centro e três pontos pulsando. Pede a senha do disco, se houver.
Window.SetBackgroundTopColor(0.043, 0.063, 0.071);
Window.SetBackgroundBottomColor(0.043, 0.063, 0.071);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 30;
logo.sprite.SetPosition(logo.x, logo.y, 10);

dot_image = Image("dot.png");
for (i = 0; i < 3; i++) {
  dots[i] = Sprite(dot_image);
  dots[i].SetPosition(Window.GetX() + Window.GetWidth() / 2 - 40 + i * 34, logo.y + logo.image.GetHeight() + 40, 10);
  dots[i].SetOpacity(0.25);
}

t = 0;
fun refresh_callback() {
  t++;
  for (i = 0; i < 3; i++) {
    phase = (t / 12 - i * 0.6);
    dots[i].SetOpacity(0.25 + 0.75 * Math.Abs(Math.Sin(phase)));
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

# senha do disco criptografado
fun display_password_callback(prompt, bullets) {
  question.image = Image.Text(prompt, 0.95, 0.98, 0.98);
  question.sprite = Sprite(question.image);
  question.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - question.image.GetWidth() / 2, logo.y + logo.image.GetHeight() + 90, 20);
  stars = "";
  for (i = 0; i < bullets; i++) stars += "•";
  answer.image = Image.Text(stars, 0.17, 0.83, 0.74);
  answer.sprite = Sprite(answer.image);
  answer.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - answer.image.GetWidth() / 2, logo.y + logo.image.GetHeight() + 130, 20);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
  question.sprite = NULL;
  answer.sprite = NULL;
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun message_callback(text) {
  msg.image = Image.Text(text, 0.64, 0.73, 0.72);
  msg.sprite = Sprite(msg.image);
  msg.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - msg.image.GetWidth() / 2, Window.GetY() + Window.GetHeight() - 80, 20);
}
Plymouth.SetMessageFunction(message_callback);
