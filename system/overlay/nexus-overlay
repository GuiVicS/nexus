#!/usr/bin/python3 -I
"""Capa do Nexus por cima de tudo (camada de sobreposição do sway, wlr-layer-shell).

A Steam é só o motor do Nexus: quando o Core precisa mexer numa janela dela (ex.: confirmar o diálogo
"Install" de um jogo), esta capa cobre a tela inteira com a cara do Nexus ("Instalando <jogo>…"). A capa não
pega teclado nem mouse (a região de entrada é vazia), então o clique que o Core manda pelo sway atravessa
até a janela da Steam por baixo. Ninguém vê a Steam.

(Os botões flutuantes "☰ Nexus / ✕ Sair" das versões anteriores saíram: o menu rápido abre com o botão Guia,
Select+Start, F1 ou a tecla Super — como num console.)

Também mostra o aviso curto por cima do jogo (`game.toast` do Core: bateria do controle baixa, disco cheio, erro…),
no canto superior direito, sem pegar teclado nem mouse e sem tirar o jogo da tela.
"""
import ctypes
import json
import os
import socket
import threading
import time

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GLib, Gtk, GtkLayerShell  # noqa: E402

SOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "nexus", "core.sock")
MAX_SECS = 60  # se o Core sumir no meio, a capa não fica para sempre

CSS = b"""
window.cover { background: #0b1012; }
.cover .title { color: #f3faf9; font-size: 34px; font-weight: 700; }
.cover .sub { color: rgba(243,250,249,.62); font-size: 18px; }
.cover .brand { color: #2bd4bd; font-size: 15px; font-weight: 700; letter-spacing: 6px; }
window.toast { background: rgba(18,27,30,.94); border-radius: 22px; border: 2px solid rgba(43,212,189,.55); }
.toast .t { color: #f3faf9; font-size: 26px; font-weight: 700; }
.toast .b { color: rgba(243,250,249,.72); font-size: 20px; }
"""


def click_through(win):
    """Região de entrada vazia: cliques e toques passam para a janela de baixo.
    Via ctypes (GDK + cairo do sistema) porque o python3-gi-cairo nem sempre está instalado."""
    try:
        gdkwin = win.get_window()
        if gdkwin is None:
            return False
        get_ptr = ctypes.pythonapi.PyCapsule_GetPointer
        get_ptr.restype = ctypes.c_void_p
        get_ptr.argtypes = [ctypes.py_object, ctypes.c_char_p]
        ptr = get_ptr(gdkwin.__gpointer__, None)
        cairo = ctypes.CDLL("libcairo.so.2")
        cairo.cairo_region_create.restype = ctypes.c_void_p
        gdk = ctypes.CDLL("libgdk-3.so.0")
        gdk.gdk_window_input_shape_combine_region.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int, ctypes.c_int]
        region = cairo.cairo_region_create()
        gdk.gdk_window_input_shape_combine_region(ptr, region, 0, 0)
        cairo.cairo_region_destroy.argtypes = [ctypes.c_void_p]
        cairo.cairo_region_destroy(region)
        return True
    except (OSError, AttributeError, ValueError, TypeError):
        return False


class Toast:
    """Aviso curto no canto, por cima do jogo (camada de sobreposição, sem foco de teclado, cliques atravessam)."""

    def __init__(self):
        self.win = Gtk.Window()
        self.win.get_style_context().add_class("toast")
        GtkLayerShell.init_for_window(self.win)
        GtkLayerShell.set_namespace(self.win, "nexus-toast")
        GtkLayerShell.set_layer(self.win, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_anchor(self.win, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_anchor(self.win, GtkLayerShell.Edge.RIGHT, True)
        GtkLayerShell.set_margin(self.win, GtkLayerShell.Edge.TOP, 48)
        GtkLayerShell.set_margin(self.win, GtkLayerShell.Edge.RIGHT, 48)
        GtkLayerShell.set_exclusive_zone(self.win, -1)
        GtkLayerShell.set_keyboard_mode(self.win, GtkLayerShell.KeyboardMode.NONE)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.set_border_width(22)
        self.title = Gtk.Label(xalign=0)
        self.title.get_style_context().add_class("t")
        self.body = Gtk.Label(xalign=0)
        self.body.get_style_context().add_class("b")
        self.body.set_line_wrap(True)
        self.body.set_max_width_chars(44)
        box.pack_start(self.title, False, False, 0)
        box.pack_start(self.body, False, False, 0)
        self.win.add(box)
        self.win.connect("map-event", lambda *_: click_through(self.win))
        self.until = 0.0
        GLib.timeout_add(500, self.tick)

    def show(self, title, body, secs):
        self.title.set_text(title or "")
        self.body.set_text(body or "")
        self.body.set_visible(bool(body))
        self.until = time.time() + max(2.0, min(float(secs or 5), 15.0))
        self.win.show_all()
        self.body.set_visible(bool(body))
        click_through(self.win)
        return False

    def hide(self):
        self.until = 0.0
        self.win.hide()
        return False

    def tick(self):
        if self.until and time.time() > self.until:
            self.hide()
        return True


class Cover:
    def __init__(self):
        self.until = 0.0
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.win = Gtk.Window()
        self.win.get_style_context().add_class("cover")
        GtkLayerShell.init_for_window(self.win)
        GtkLayerShell.set_namespace(self.win, "nexus-cover")
        GtkLayerShell.set_layer(self.win, GtkLayerShell.Layer.OVERLAY)
        for e in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM, GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(self.win, e, True)
        GtkLayerShell.set_exclusive_zone(self.win, -1)
        GtkLayerShell.set_keyboard_mode(self.win, GtkLayerShell.KeyboardMode.NONE)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_halign(Gtk.Align.CENTER)
        box.set_valign(Gtk.Align.CENTER)
        brand = Gtk.Label(label="NEXUS")
        brand.get_style_context().add_class("brand")
        self.spin = Gtk.Spinner()
        self.spin.set_size_request(42, 42)
        self.title = Gtk.Label()
        self.title.get_style_context().add_class("title")
        self.sub = Gtk.Label(label="Preparando o download…")
        self.sub.get_style_context().add_class("sub")
        for w in (brand, self.spin, self.title, self.sub):
            box.pack_start(w, False, False, 0)
        self.win.add(box)
        self.win.connect("map-event", lambda *_: click_through(self.win))

        self.toast = Toast()
        GLib.timeout_add(1000, self.tick)
        threading.Thread(target=self.watch_core, daemon=True).start()

    def show(self, title):
        self.title.set_text(f"Instalando {title}" if title else "Instalando")
        self.until = time.time() + MAX_SECS
        self.win.show_all()
        self.spin.start()
        click_through(self.win)
        return False

    def hide(self):
        self.until = 0.0
        self.spin.stop()
        self.win.hide()
        return False

    def tick(self):
        if self.until and time.time() > self.until:
            self.hide()
        return True

    def watch_core(self):
        """Eventos do Core: steam.dialog {open, title}. Reconecta se o Core reiniciar."""
        while True:
            try:
                s = socket.socket(socket.AF_UNIX)
                s.connect(SOCK)
                s.sendall(b'{"jsonrpc":"2.0","id":1,"method":"hello","params":{}}\n')
                for line in s.makefile("r"):
                    msg = json.loads(line)
                    if msg.get("method") == "game.toast":
                        p = msg.get("params") or {}
                        GLib.idle_add(self.toast.show, p.get("title") or "", p.get("body") or "", p.get("secs") or 5)
                    elif msg.get("method") == "steam.dialog":
                        p = msg.get("params") or {}
                        if p.get("open"):
                            GLib.idle_add(self.show, p.get("title") or "")
                        else:
                            GLib.idle_add(self.hide)
            except (OSError, ValueError):
                pass
            GLib.idle_add(self.hide)
            time.sleep(2)


if __name__ == "__main__":
    Cover()
    Gtk.main()
