[Unit]
StartLimitIntervalSec=0
Description=Nexus Core (biblioteca, provedores e jogos)
PartOf=nexus-session.target

[Service]
Slice=nexus.slice
Type=simple
ExecStart=/usr/bin/nexus-core
Restart=always
RestartSec=1
Environment=RUST_LOG=info
# Jogos e a Steam rodam em escopos próprios (systemd-run --scope): reiniciar o Core não derruba o que está aberto
Environment=NEXUS_SYSTEMD_SCOPE=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/games
ExecStartPre=/bin/mkdir -p %h/.local/share/nexus %h/.cache/nexus
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=nexus-session.target
