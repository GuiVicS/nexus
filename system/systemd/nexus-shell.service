[Unit]
StartLimitIntervalSec=0
Description=Nexus Shell (interface de TV)
After=nexus-core.service
PartOf=nexus-session.target

[Service]
Type=simple
ExecStart=/opt/nexus/shell/nexus-shell --ozone-platform=wayland $NEXUS_SHELL_FLAGS
Environment=NEXUS_KIOSK=1
Restart=on-failure
RestartSec=1
# SIGTERM só no processo principal (ele fecha os filhos do Chromium); o resto recebe SIGKILL se sobrar
KillMode=mixed
TimeoutStopSec=5
# se a Shell travar o Core reconcilia o estado (jogo aberto continua)
