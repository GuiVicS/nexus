[Unit]
Description=Nexus Shell (interface de TV)
After=nexus-core.service
PartOf=nexus-session.target

[Service]
Type=simple
ExecStart=/opt/nexus/shell/nexus-shell --ozone-platform=wayland --enable-features=UseOzonePlatform
Environment=NEXUS_KIOSK=1
Restart=on-failure
RestartSec=1
# se a Shell travar o Core reconcilia o estado (jogo aberto continua)
