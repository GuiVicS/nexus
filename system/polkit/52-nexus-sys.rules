// Nexus: quem está na frente da TV (sessão local ativa) pode atualizar o Nexus/o sistema e ligar ou desligar o
// servidor SSH, sem senha do sistema. Só a unidade nexus-sys@<ação>.service; o ajudante
// (/usr/lib/nexus/nexus-sys-helper) valida a ação. O Core só pede depois do PIN dos responsáveis.
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" && subject.active && subject.local) {
    var unit = action.lookup("unit") || "";
    var verb = action.lookup("verb") || "";
    if (verb == "start" && /^nexus-sys@(update-nexus:(latest|[0-9]+\.[0-9]+\.[0-9]+)|upgrade-system|ssh-on|ssh-off)\.service$/.test(unit)) {
      return polkit.Result.YES;
    }
  }
  return polkit.Result.NOT_HANDLED;
});
